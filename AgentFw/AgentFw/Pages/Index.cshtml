@page
@model IndexModel
@{
    ViewData["Title"] = "Yapılacaklar";
    var remaining = Model.Todos.Count(t => !t.IsCompleted);
}

<div class="todo-wrapper mx-auto">
    <div class="d-flex align-items-baseline justify-content-between mb-3">
        <h1 class="h3 mb-0">Yapılacaklar</h1>
        <span class="text-muted small">@remaining / @Model.Todos.Count kaldı</span>
    </div>

    <form method="post" asp-page-handler="Add" class="mb-1">
        <div class="input-group">
            <input asp-for="NewTitle" class="form-control" placeholder="Yeni görev ekle..." autocomplete="off" autofocus />
            <button type="submit" class="btn btn-primary">Ekle</button>
        </div>
        <span asp-validation-for="NewTitle" class="text-danger small"></span>
    </form>

    @if (Model.Todos.Count == 0)
    {
        <p class="text-muted text-center mt-4">Henüz görev yok. Yukarıdan ilk görevini ekle.</p>
    }
    else
    {
        <ul class="list-group mt-3">
            @foreach (var todo in Model.Todos)
            {
                <li class="list-group-item d-flex align-items-center gap-2 @(todo.IsCompleted ? "todo-done" : "")">
                    <form method="post" asp-page-handler="Toggle" asp-route-id="@todo.Id" class="m-0">
                        <button type="submit" class="btn btn-sm todo-check" title="@(todo.IsCompleted ? "Geri al" : "Tamamlandı olarak işaretle")"
                                aria-label="@(todo.IsCompleted ? "Geri al" : "Tamamlandı olarak işaretle")">
                            @(todo.IsCompleted ? "✓" : "")
                        </button>
                    </form>

                    <span class="flex-grow-1 todo-title">@todo.Title</span>

                    <form method="post" asp-page-handler="Delete" asp-route-id="@todo.Id" class="m-0">
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Sil" aria-label="Sil">Sil</button>
                    </form>
                </li>
            }
        </ul>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
